# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# build artefacts
dist/
build/
*.egg-info/

# machine-specific configuration (copy kletz.example.toml)
kletz.toml

# runtime data: the database is the source of truth and the workbook is a generated view
*.db
*.db-journal
*.xlsx
~$*
*.tmp
# generated views (diagrams, documents) when the output folder is left at its default next to the database
out/

# family lock files, should the lock directory ever be pointed inside the repo (it belongs in %LOCALAPPDATA%\asi\locks)
*.lock
*.lock.json
# uv.lock is the dependency lock, not a family lock: it stays tracked
!uv.lock

# OS
Thumbs.db
desktop.ini
